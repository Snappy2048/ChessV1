import tkinter as tk
from tkinter import ttk
import tkinter.simpledialog as simpledialog
import chess
import random
import os

# --- Configuration ---
SQUARE_SIZE = 64
AI_LEVEL = 2  # 1=Easy, 2=Medium, 3=Hard
LEVEL_DEPTH = {1:1, 2:2, 3:5}  # Hard is depth 6            # 6 is too slow so 5
PIECES_UNICODE = {
    'P':'♙','N':'♘','B':'♗','R':'♖','Q':'♕','K':'♔',
    'p':'♟','n':'♞','b':'♝','r':'♜','q':'♛','k':'♚'
}
LOG_FOLDER = r"C:\Users\aadit\OneDrive\Desktop\chess"

# --- Ask for player name ---
root_temp = tk.Tk()
root_temp.withdraw()  # Hide temporary window
PLAYER_NAME = simpledialog.askstring("Player Name", "Enter your name:", initialvalue="Player")
if not PLAYER_NAME:
    PLAYER_NAME = "Player"
AI_NAME = "AI"
root_temp.destroy()

# --- Chess GUI ---
class ChessGUI:
    def __init__(self, master):
        self.master = master
        master.title("Python Chess ♟️")
        self.board = chess.Board()
        self.selected_square = None
        self.valid_moves = []
        self.captured_white = []
        self.captured_black = []

        # Canvas
        self.canvas = tk.Canvas(master, width=8*SQUARE_SIZE, height=8*SQUARE_SIZE)
        self.canvas.pack(side=tk.LEFT)
        self.canvas.bind("<Button-1>", self.on_click)

        # Sidebar
        self.sidebar = tk.Frame(master, padx=10, pady=10)
        self.sidebar.pack(side=tk.RIGHT, fill=tk.Y)
        tk.Label(self.sidebar, text="Difficulty:", font=("Arial", 12, "bold")).pack(pady=5)
        self.level_select = ttk.Combobox(self.sidebar, values=["Easy","Medium","Hard"], state="readonly")
        self.level_select.current(AI_LEVEL-1)
        self.level_select.pack(pady=5)
        self.level_select.bind("<<ComboboxSelected>>", self.change_difficulty)

        self.status = tk.Label(self.sidebar, text=f"{PLAYER_NAME}'s move (White)", font=("Arial",12))
        self.status.pack(pady=20)

        tk.Label(self.sidebar, text="Captured Pieces:", font=("Arial",12,"bold")).pack(pady=5)
        self.captured_white_label = tk.Label(self.sidebar, text="White: ", font=("Arial",10))
        self.captured_white_label.pack(anchor="w")
        self.captured_black_label = tk.Label(self.sidebar, text="Black: ", font=("Arial",10))
        self.captured_black_label.pack(anchor="w")

        self.draw_board()
        self.draw_pieces()
        self.update_captured_labels()

    def change_difficulty(self,event):
        global AI_LEVEL
        level = self.level_select.get()
        AI_LEVEL = {"Easy":1,"Medium":2,"Hard":3}[level]
        self.status.config(text=f"Difficulty set to {level}")

    def draw_board(self):
        self.canvas.delete("square")
        colors = ["#EEEED2","#769656"]
        for row in range(8):
            for col in range(8):
                color = colors[(row+col)%2]
                x1=col*SQUARE_SIZE
                y1=(7-row)*SQUARE_SIZE
                x2=x1+SQUARE_SIZE
                y2=y1+SQUARE_SIZE
                self.canvas.create_rectangle(x1,y1,x2,y2,fill=color,tags="square")
        # Highlight selected piece
        if self.selected_square is not None:
            sel_row=7-chess.square_rank(self.selected_square)
            sel_col=chess.square_file(self.selected_square)
            x1=sel_col*SQUARE_SIZE
            y1=sel_row*SQUARE_SIZE
            x2=x1+SQUARE_SIZE
            y2=y1+SQUARE_SIZE
            self.canvas.create_rectangle(x1,y1,x2,y2,outline="lightblue",width=4,tags="square")
        # Draw move circles
        for move in self.valid_moves:
            to_sq=move.to_square
            col=chess.square_file(to_sq)
            row=7-chess.square_rank(to_sq)
            x=col*SQUARE_SIZE+SQUARE_SIZE/2
            y=row*SQUARE_SIZE+SQUARE_SIZE/2
            self.canvas.create_oval(x-8,y-8,x+8,y+8,fill="gray30",outline="",tags="square")

    def draw_pieces(self):
        self.canvas.delete("piece")
        for square,piece in self.board.piece_map().items():
            row=7-chess.square_rank(square)
            col=chess.square_file(square)
            x=col*SQUARE_SIZE+SQUARE_SIZE/2
            y=row*SQUARE_SIZE+SQUARE_SIZE/2
            self.canvas.create_text(x,y,text=PIECES_UNICODE[piece.symbol()],font=("Arial",40),tags="piece")

    def update_captured_labels(self):
        self.captured_white_label.config(text="White: "+" ".join(self.captured_white))
        self.captured_black_label.config(text="Black: "+" ".join(self.captured_black))

    def log_result(self):
        result = self.board.result()
        os.makedirs(LOG_FOLDER, exist_ok=True)
        file_path = os.path.join(LOG_FOLDER, "results.txt")
        with open(file_path,"a") as f:
            if result=="1-0":
                f.write(f"{PLAYER_NAME} (White) won\n")
            elif result=="0-1":
                f.write(f"{AI_NAME} (Black) won\n")
            else:
                f.write("Draw\n")

    def on_click(self,event):
        col=event.x//SQUARE_SIZE
        row=7-(event.y//SQUARE_SIZE)
        square=chess.square(col,row)
        if self.selected_square is None:
            piece=self.board.piece_at(square)
            if piece and piece.color==chess.WHITE:
                self.selected_square=square
                self.valid_moves=[m for m in self.board.legal_moves if m.from_square==square]
        else:
            move=chess.Move(self.selected_square,square)
            piece=self.board.piece_at(self.selected_square)
            if piece and piece.piece_type==chess.PAWN and chess.square_rank(square)==7:
                move=chess.Move(self.selected_square,square,promotion=chess.QUEEN)
            if move in self.board.legal_moves:
                captured=self.board.piece_at(move.to_square)
                if captured:
                    if captured.color==chess.WHITE:
                        self.captured_white.append(PIECES_UNICODE[captured.symbol()])
                    else:
                        self.captured_black.append(PIECES_UNICODE[captured.symbol()])
                self.board.push(move)
                self.selected_square=None
                self.valid_moves=[]
                self.draw_board()
                self.draw_pieces()
                self.update_captured_labels()
                if self.board.is_game_over():
                    self.status.config(text=f"Game Over! Result: {self.board.result()}")
                    self.log_result()
                    return
                self.status.config(text=f"{AI_NAME} thinking...")
                self.master.after(100,self.computer_move)
            else:
                self.selected_square=None
                self.valid_moves=[]
        self.draw_board()
        self.draw_pieces()

    def evaluate_board(self):
        values={chess.PAWN:100,chess.KNIGHT:320,chess.BISHOP:330,chess.ROOK:500,chess.QUEEN:900,chess.KING:20000}
        score=0
        for square,piece in self.board.piece_map().items():
            value=values[piece.piece_type]
            rank=chess.square_rank(square)
            file=chess.square_file(square)
            center_bonus=10-(abs(3.5-rank)+abs(3.5-file))*2
            score+=(value+center_bonus) if piece.color==chess.WHITE else -(value+center_bonus)
        return score

    def minimax(self,depth,alpha,beta,maximizing):
        if depth==0 or self.board.is_game_over():
            return self.evaluate_board()
        moves=list(self.board.legal_moves)
        if AI_LEVEL==3:
            moves.sort(key=lambda m:0 if self.board.is_capture(m) else 1)
        if maximizing:
            max_eval=-999999
            for move in moves:
                self.board.push(move)
                val=self.minimax(depth-1,alpha,beta,False)
                self.board.pop()
                max_eval=max(max_eval,val)
                alpha=max(alpha,val)
                if beta<=alpha:
                    break
            return max_eval
        else:
            min_eval=999999
            for move in moves:
                self.board.push(move)
                val=self.minimax(depth-1,alpha,beta,True)
                self.board.pop()
                min_eval=min(min_eval,val)
                beta=min(beta,val)
                if beta<=alpha:
                    break
            return min_eval

    def get_best_move(self,depth):
        best_move=None
        best_value=-999999
        moves=list(self.board.legal_moves)
        if AI_LEVEL==1 or AI_LEVEL==2:
            random.shuffle(moves)
        for move in moves:
            self.board.push(move)
            value=-self.minimax(depth-1,-1000000,1000000,False)
            self.board.pop()
            if AI_LEVEL<3:
                value+=random.randint(-30,30)
            if value>best_value:
                best_value=value
                best_move=move
        return best_move

    def computer_move(self):
        if self.board.is_game_over(): return
        depth=LEVEL_DEPTH.get(AI_LEVEL,2)
        best_move=self.get_best_move(depth)
        if best_move:
            piece=self.board.piece_at(best_move.from_square)
            if piece and piece.piece_type==chess.PAWN and chess.square_rank(best_move.to_square)==0:
                best_move=chess.Move(best_move.from_square,best_move.to_square,promotion=chess.QUEEN)
            captured=self.board.piece_at(best_move.to_square)
            if captured:
                if captured.color==chess.WHITE:
                    self.captured_white.append(PIECES_UNICODE[captured.symbol()])
                else:
                    self.captured_black.append(PIECES_UNICODE[captured.symbol()])
            self.board.push(best_move)
            self.draw_board()
            self.draw_pieces()
            self.update_captured_labels()
            if self.board.is_game_over():
                self.status.config(text=f"Game Over! Result: {self.board.result()}")
                self.log_result()
            else:
                self.status.config(text=f"{PLAYER_NAME}'s move (White)")

# --- Run the game ---
root=tk.Tk()
app=ChessGUI(root)
root.mainloop()
